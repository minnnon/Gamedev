--- !u!114 &1265281650
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1265281648}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0415\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442 \u0443
    \u0421\u0435\u043A\u0442\u043E\u0440\u0456 7 \u0432\u0438\u0439\u0448\u043E\u0432
    \u0437-\u043F\u0456\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E. \u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0441
    \u0437\u0430\u043F\u043E\u043B\u043E\u043D\u0438\u043B\u0438 \u0431\u0456\u043E\u0430\u043D\u043E\u043C\u0430\u043B\u0456\u0457,
    \u0430 \u043F\u043E\u0432\u0456\u0442\u0440\u044F \u0441\u0442\u0430\u043B\u043E
    \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u0438\u043C \u0434\u043B\u044F
    \u043B\u044E\u0434\u0435\u0439.\n\n\u0422\u0456, \u0445\u0442\u043E \u0432\u0438\u0436\u0438\u0432,
    \u0437\u0456\u0431\u0440\u0430\u043B\u0438 \u0442\u0435\u0431\u0435 \u2014 \u0440\u043E\u0431\u043E\u0442\u0430-\u043B\u0456\u043A\u0432\u0456\u0434\u0430\u0442\u043E\u0440\u0430
    \xAB\u0406\u0441\u043A\u0440\u0443\xBB. \u0422\u043E\u0431\u0456 \u043E\u0442\u0440\u0443\u0442\u0430
    \u043D\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u0430.\n\n\u0422\u0432\u043E\u0454
    \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F: \u043F\u0440\u043E\u0431\u0438\u0442\u0438\u0441\u044F
    \u0442\u0443\u0434\u0438, \u0434\u0435 \u0432\u0441\u0435 \u043F\u043E\u0447\u0430\u043B\u043E\u0441\u044F,
    \u0456 \u0437\u043D\u0430\u0439\u0442\u0438 \u0434\u0430\u043D\u0456 \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0456\u0432.
    \u041C\u0435\u0440\u0435\u0436\u0430 \u043C\u0435\u0440\u0442\u0432\u0430 \u2014
    \u0433\u0435\u0440\u043C\u043E\u0448\u043B\u044E\u0437\u0438 \u0432\u0456\u0434\u0447\u0438\u043D\u044F\u044E\u0442\u044C\u0441\u044F
    \u043B\u0438\u0448\u0435 \u0432\u0456\u0434 \u0435\u043D\u0435\u0440\u0433\u043E\u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0456\u0432."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d7d75eaf98517964d8f33c8e2902868d, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 7431e9ac05188ae43860b37c44e218b8, type: 2}
