--- !u!114 &2059577841
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2059577839}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 629961c9f0509a94186f17d798f5ea18, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Note
  title: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430"
  body: "\u0412\u0437\u044F\u0432 \u043F\u0435\u0440\u0441\u0442\u0435\u043D\u044C.
    \u0422\u0456\u043B\u044C\u043A\u0438 \u043F\u0435\u0440\u0441\u0442\u0435\u043D\u044C,
    \u0440\u0435\u0448\u0442\u0430 \u2014 \u043C\u043E\u0442\u043B\u043E\u0445. \u0425\u043B\u043E\u043F\u0446\u0456
    \u043F\u043E\u0431\u0456\u0433\u043B\u0438 \u043D\u0430\u0433\u043E\u0440\u0443,
    \u0430 \u044F \u0437\u0430\u0433\u0443\u0431\u0438\u0432 \u0434\u043E\u0440\u043E\u0433\u0443.
    \u0427\u0443\u044E \u043A\u0440\u043E\u043A\u0438. \u0426\u0435 \u043D\u0435
    \u0445\u043B\u043E\u043F\u0446\u0456."
