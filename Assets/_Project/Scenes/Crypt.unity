  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 629961c9f0509a94186f17d798f5ea18, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Note
  title: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430"
  body: "\u0411\u0456\u043B\u044F \u0431\u0440\u0430\u043C\u0438 \u0441\u0442\u043E\u0457\u0442\u044C
    \u043F\u0435\u0440\u0448\u0438\u0439 \u0441\u0442\u043E\u0440\u043E\u0436. \u0412\u0456\u043D
    \u0442\u0443\u0442 \u0441\u0442\u043E\u044F\u0432 \u0449\u0435 \u0434\u043E \u043C\u0435\u043D\u0435.
    \u041D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0438 \u0432\u0456\u043D \u0449\u0435
    \u043F\u0430\u043C'\u044F\u0442\u0430\u0454, \u043A\u043E\u0433\u043E \u043C\u0430\u0454
    \u0441\u0442\u0435\u0440\u0435\u0433\u0442\u0438. \u0410\u043B\u0435 \u0431'\u0454
    \u0432\u0456\u043D \u0442\u0430\u043A \u0441\u0430\u043C\u043E."
