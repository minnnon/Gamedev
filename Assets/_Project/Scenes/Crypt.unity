  m_Script: {fileID: 11500000, guid: 629961c9f0509a94186f17d798f5ea18, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Note
  title: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430"
  body: "\u041D\u0438\u0436\u043D\u044E \u0431\u0440\u0430\u043C\u0443 \u044F \u0437\u0430\u043A\u0440\u0438\u0432
    \u043D\u0430 \u0442\u0440\u0438 \u0440\u0443\u043D\u0438. \u0420\u043E\u0437\u043D\u0456\u0441
    \u0457\u0445 \u043F\u043E \u0441\u043A\u043B\u0435\u043F\u0443, \u0449\u043E\u0431
    \u0436\u043E\u0434\u0435\u043D \u0434\u0443\u0440\u0435\u043D\u044C \u043D\u0435
    \u043F\u043E\u043B\u0456\u0437 \u0443\u043D\u0438\u0437. \u042F\u043A\u0449\u043E
    \u0442\u0438 \u0457\u0445 \u0437\u0431\u0438\u0440\u0430\u0454\u0448 \u2014 \u0442\u043E
    \u0442\u0438 \u0441\u0430\u043C\u0435 \u0442\u043E\u0439 \u0434\u0443\u0440\u0435\u043D\u044C."
