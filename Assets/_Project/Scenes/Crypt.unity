  m_Script: {fileID: 11500000, guid: 629961c9f0509a94186f17d798f5ea18, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Note
  title: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430"
  body: "\u041E\u0441\u0456\u043D\u044C. \u042F\u043A\u0456\u0441\u044C \u0440\u043E\u0437\u0443\u043C\u043D\u0438\u043A\u0438
    \u0440\u043E\u0437\u043A\u043E\u043F\u0430\u043B\u0438 \u043D\u0438\u0436\u043D\u044E
    \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u044E. \u0429\u043E\u0441\u044C \u0432\u0438\u043D\u0435\u0441\u043B\u0438.
    \u0412\u0456\u0434\u0442\u043E\u0434\u0456 \u043C\u0435\u0440\u0446\u0456 \u043D\u0435
    \u043B\u0435\u0436\u0430\u0442\u044C. \u0427\u0443\u0434\u043E\u0432\u043E. \u0421\u0430\u043C\u0435
    \u0446\u044C\u043E\u0433\u043E \u043C\u0435\u043D\u0456 \u043D\u0430 \u0441\u0442\u0430\u0440\u0456\u0441\u0442\u044C
    \u0456 \u0431\u0440\u0430\u043A\u0443\u0432\u0430\u043B\u043E."
