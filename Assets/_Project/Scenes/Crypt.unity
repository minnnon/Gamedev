  captions:
  - "\u041F\u0456\u0434 \u043D\u0430\u0448\u0438\u043C \u0441\u0435\u043B\u043E\u043C
    \u0454 \u0441\u0442\u0430\u0440\u0438\u0439 \u0441\u043A\u043B\u0435\u043F."
  - "\u0422\u0438\u0436\u0434\u0435\u043D\u044C \u0442\u043E\u043C\u0443 \u0437\u043D\u0438\u043A
    \u0441\u0442\u043E\u0440\u043E\u0436 \u0413\u043D\u0430\u0442, \u0430 \u043D\u043E\u0447\u0430\u043C\u0438
    \u0431\u0456\u043B\u044F \u0446\u0432\u0438\u043D\u0442\u0430\u0440\u044F \u0431\u0430\u0447\u0430\u0442\u044C
    \u043A\u0456\u0441\u0442\u044F\u043A\u0456\u0432."
  - "\u0421\u0442\u0430\u0440\u043E\u0441\u0442\u0430 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0432,
    \u0449\u043E\u0431 \u044F \u0441\u043F\u0443\u0441\u0442\u0438\u0432\u0441\u044F
    \u0456 \u0440\u043E\u0437\u0456\u0431\u0440\u0430\u0432\u0441\u044F. \u0413\u0440\u043E\u0448\u0456
    \u0432\u043F\u0435\u0440\u0435\u0434. \u041D\u0430\u0437\u0430\u0434 \u2014 \u044F\u043A
    \u0432\u0438\u0439\u0434\u0435."
